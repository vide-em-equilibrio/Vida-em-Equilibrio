<title>Vida em Equilíbrio | Saúde e Bem-estar</title>


<style>

/* =========================================================

   RESET + VARIÁVEIS

========================================================= */

:root {

    --bg: #f7faf8;

    --surface: #ffffff;

    --surface-2: #eef7f1;

    --text: #17251d;

    --muted: #66756d;

    --primary: #176b48;

    --primary-2: #2c9a68;

    --primary-dark: #0e4d34;

    --line: #dfe9e3;

    --shadow: 0 18px 50px rgba(21, 67, 45, .10);

    --shadow-soft: 0 8px 30px rgba(21, 67, 45, .08);

    --radius: 24px;

    --radius-sm: 16px;

    --max: 1180px;

}


* {

    margin: 0;

    padding: 0;

    box-sizing: border-box;

}


html {

    scroll-behavior: smooth;

    scroll-padding-top: 88px;

}


body {

    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,

                 "Segoe UI", sans-serif;

    background: var(--bg);

    color: var(--text);

    line-height: 1.65;

    overflow-x: hidden;

}


button,

input {

    font: inherit;

}


button {

    cursor: pointer;

}


a {

    color: inherit;

}


.container {

    width: min(var(--max), calc(100% - 40px));

    margin-inline: auto;

}


/* =========================================================

   HEADER

========================================================= */

.header {

    position: fixed;

    inset: 0 0 auto;

    z-index: 1000;

    padding: 14px 0;

    background: rgba(247, 250, 248, .82);

    backdrop-filter: blur(18px);

    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(223, 233, 227, .75);

    transition: .25s ease;

}


.header.scrolled {

    box-shadow: 0 8px 30px rgba(20, 55, 38, .08);

}


.navbar {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

}


.brand {

    display: flex;

    align-items: center;

    gap: 11px;

    text-decoration: none;

    font-weight: 850;

    letter-spacing: -.4px;

}


.brand-mark {

    width: 40px;

    height: 40px;

    display: grid;

    place-items: center;

    border-radius: 13px;

    background: var(--primary);

    color: white;

    font-size: 20px;

    box-shadow: 0 8px 20px rgba(23, 107, 72, .20);

}


.brand-text span {

    display: block;

    font-size: 16px;

}


.brand-text small {

    display: block;

    color: var(--muted);

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 1.3px;

    text-transform: uppercase;

}


.nav-links {

    display: flex;

    align-items: center;

    gap: 6px;

}


.nav-links a {

    text-decoration: none;

    color: var(--muted);

    padding: 9px 13px;

    border-radius: 10px;

    font-size: 14px;

    font-weight: 700;

    transition: .2s ease;

}


.nav-links a:hover,

.nav-links a.active {

    color: var(--primary);

    background: var(--surface-2);

}


.menu-btn {

    display: none;

    border: 0;

    background: var(--surface);

    width: 42px;

    height: 42px;

    border-radius: 12px;

    box-shadow: var(--shadow-soft);

}


/* =========================================================

   HERO

========================================================= */

.hero {

    min-height: 760px;

    padding: 150px 0 90px;

    position: relative;

    display: grid;

    align-items: center;

    overflow: hidden;

    background:

        radial-gradient(circle at 78% 23%, rgba(95, 188, 132, .22), transparent 28%),

        radial-gradient(circle at 88% 80%, rgba(52, 145, 98, .12), transparent 25%),

        linear-gradient(135deg, #f7faf8 0%, #eef7f1 100%);

}


.hero::before {

    content: "";

    position: absolute;

    width: 520px;

    height: 520px;

    border-radius: 50%;

    right: -190px;

    top: 80px;

    border: 1px solid rgba(23, 107, 72, .10);

}


.hero::after {

    content: "";

    position: absolute;

    width: 360px;

    height: 360px;

    border-radius: 50%;

    left: -210px;

    bottom: -180px;

    background: rgba(44, 154, 104, .07);

}


.hero-grid {

    position: relative;

    z-index: 1;

    display: grid;

    grid-template-columns: 1.03fr .97fr;

    gap: 70px;

    align-items: center;

}


.eyebrow {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 8px 12px;

    border-radius: 999px;

    background: rgba(23, 107, 72, .08);

    color: var(--primary);

    font-size: 12px;

    font-weight: 850;

    letter-spacing: 1px;

    text-transform: uppercase;

    margin-bottom: 20px;

}


.eyebrow::before {

    content: "";

    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: var(--primary-2);

    box-shadow: 0 0 0 5px rgba(44, 154, 104, .10);

}


.hero h1 {

    max-width: 720px;

    font-size: clamp(44px, 6vw, 76px);

    line-height: .98;

    letter-spacing: -4px;

    margin-bottom: 24px;

}


.hero h1 span {

    color: var(--primary);

}


.hero-description {

    max-width: 650px;

    color: var(--muted);

    font-size: 18px;

    margin-bottom: 34px;

}


.hero-actions {

    display: flex;

    flex-wrap: wrap;

    gap: 12px;

    margin-bottom: 35px;

}


.btn {

    border: 0;

    border-radius: 13px;

    padding: 13px 19px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    text-decoration: none;

    font-size: 14px;

    font-weight: 800;

    transition: .22s ease;

}


.btn-primary {

    background: var(--primary);

    color: white;

    box-shadow: 0 10px 25px rgba(23, 107, 72, .20);

}


.btn-primary:hover {

    background: var(--primary-dark);

    transform: translateY(-2px);

}


.btn-secondary {

    background: white;

    border: 1px solid var(--line);

    color: var(--text);

}


.btn-secondary:hover {

    border-color: #bfd4c8;

    transform: translateY(-2px);

}


.hero-proof {

    display: flex;

    flex-wrap: wrap;

    gap: 18px;

    color: var(--muted);

    font-size: 13px;

    font-weight: 650;

}


.proof {

    display: flex;

    align-items: center;

    gap: 7px;

}


.proof strong {

    color: var(--primary);

}


.hero-visual {

    min-height: 500px;

    position: relative;

}


.dashboard {

    position: absolute;

    inset: 15px 0 15px 35px;

    background: rgba(255, 255, 255, .88);

    border: 1px solid rgba(255, 255, 255, .9);

    border-radius: 32px;

    box-shadow: 0 35px 90px rgba(25, 73, 49, .16);

    padding: 26px;

    backdrop-filter: blur(12px);

}


.dashboard-top {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 22px;

}


.dashboard-title {

    font-size: 14px;

    font-weight: 850;

}


.dashboard-status {

    font-size: 11px;

    font-weight: 800;

    color: var(--primary);

    background: #e5f4eb;

    border-radius: 999px;

    padding: 6px 9px;

}


.balance-card {

    background: linear-gradient(135deg, var(--primary-dark), var(--primary-2));

    color: white;

    border-radius: 23px;

    padding: 25px;

    margin-bottom: 18px;

    position: relative;

    overflow: hidden;

}


.balance-card::after {

    content: "✦";

    position: absolute;

    right: 25px;

    top: 17px;

    font-size: 80px;

    opacity: .08;

}


.balance-card small {

    opacity: .8;

    font-weight: 700;

}


.balance-card h3 {

    font-size: 32px;

    margin: 5px 0;

    letter-spacing: -1px;

}


.balance-card p {

    opacity: .8;

    font-size: 12px;

}


.mini-grid {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 14px;

}


.mini-card {

    padding: 19px;

    border: 1px solid var(--line);

    border-radius: 18px;

    background: white;

}


.mini-icon {

    font-size: 23px;

    margin-bottom: 8px;

}


.mini-card strong {

    display: block;

    font-size: 16px;

}


.mini-card span {

    color: var(--muted);

    font-size: 11px;

}


.chart {

    margin-top: 14px;

    height: 100px;

    border-radius: 16px;

    background: linear-gradient(to top, #eef7f1, transparent);

    position: relative;

    overflow: hidden;

}


.chart::before {

    content: "";

    position: absolute;

    inset: 25px 15px 15px;

    background:

        linear-gradient(145deg,

        transparent 0 18%,

        rgba(44, 154, 104, .85) 19% 20%,

        transparent 21% 39%,

        rgba(44, 154, 104, .85) 40% 41%,

        transparent 42% 60%,

        rgba(44, 154, 104, .85) 61% 62%,

        transparent 63% 76%,

        rgba(44, 154, 104, .85) 77% 78%,

        transparent 79%);

}


/* =========================================================

   SEÇÕES

========================================================= */

.section {

    padding: 100px 0;

}


.section.alt {

    background: var(--surface);

}


.section-head {

    max-width: 720px;

    margin-bottom: 45px;

}


.section-head.center {

    text-align: center;

    margin-inline: auto;

}


.kicker {

    color: var(--primary);

    font-size: 12px;

    font-weight: 900;

    letter-spacing: 1.5px;

    text-transform: uppercase;

    margin-bottom: 10px;

}


.section h2 {

    font-size: clamp(32px, 4vw, 48px);

    line-height: 1.05;

    letter-spacing: -2px;

    margin-bottom: 14px;

}


.section-head p {

    color: var(--muted);

    font-size: 16px;

}


/* =========================================================

   CARDS

========================================================= */

.cards {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;

}


.card {

    background: var(--surface);

    border: 1px solid var(--line);

    border-radius: var(--radius);

    padding: 29px;

    box-shadow: var(--shadow-soft);

    transition: .25s ease;

    position: relative;

    overflow: hidden;

}


.card:hover {

    transform: translateY(-6px);

    box-shadow: var(--shadow);

    border-color: #cdded4;

}


.card-number {

    position: absolute;

    top: 22px;

    right: 24px;

    color: #d7e7de;

    font-size: 44px;

    font-weight: 900;

}


.card-icon {

    width: 55px;

    height: 55px;

    display: grid;

    place-items: center;

    border-radius: 17px;

    background: var(--surface-2);

    font-size: 26px;

    margin-bottom: 20px;

}


.card h3 {

    font-size: 20px;

    margin-bottom: 10px;

}


.card p {

    color: var(--muted);

    font-size: 14px;

}


/* =========================================================

   TIPS

========================================================= */

.tip-layout {

    display: grid;

    grid-template-columns: .8fr 1.2fr;

    gap: 25px;

    align-items: stretch;

}


.tip-intro {

    background: var(--primary);

    color: white;

    border-radius: 28px;

    padding: 35px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    overflow: hidden;

    position: relative;

}


.tip-intro::after {

    content: "✦";

    position: absolute;

    font-size: 230px;

    right: -50px;

    bottom: -100px;

    opacity: .08;

}


.tip-intro h3 {

    font-size: 29px;

    line-height: 1.1;

    margin-bottom: 12px;

}


.tip-intro p {

    opacity: .78;

    font-size: 14px;

}


.tip-box {

    background: var(--surface);

    border: 1px solid var(--line);

    border-radius: 28px;

    padding: 35px;

    box-shadow: var(--shadow-soft);

    display: flex;

    flex-direction: column;

    justify-content: center;

}


.tip-category {

    color: var(--primary);

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 1.2px;

    text-transform: uppercase;

    margin-bottom: 12px;

}


#tip-text {

    min-height: 82px;

    font-size: clamp(22px, 3vw, 31px);

    line-height: 1.18;

    letter-spacing: -.8px;

    font-weight: 800;

    margin-bottom: 24px;

}


.tip-actions {

    display: flex;

    gap: 10px;

}


/* =========================================================

   INTERATIVO / QUIZ

========================================================= */

.interactive {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 22px;

}


.panel {

    background: var(--surface);

    border: 1px solid var(--line);

    border-radius: 28px;

    padding: 30px;

    box-shadow: var(--shadow-soft);

}


.panel-title {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

}


.panel-title .icon {

    width: 48px;

    height: 48px;

    display: grid;

    place-items: center;

    border-radius: 15px;

    background: var(--surface-2);

    font-size: 22px;

}


.panel-title h3 {

    font-size: 20px;

}


.panel-title p {

    color: var(--muted);

    font-size: 12px;

}


.progress-track {

    height: 9px;

    border-radius: 99px;

    background: #e7eee9;

    overflow: hidden;

    margin: 18px 0 25px;

}


.progress-fill {

    height: 100%;

    width: 0;

    background: var(--primary-2);

    transition: width .35s ease;

}


.quiz-meta {

    display: flex;

    justify-content: space-between;

    color: var(--muted);

    font-size: 12px;

    font-weight: 800;

    margin-bottom: 18px;

}


#question {

    font-size: 21px;

    line-height: 1.25;

    font-weight: 800;

    margin-bottom: 20px;

}


.options {

    display: grid;

    gap: 9px;

}


.option {

    text-align: left;

    border: 1px solid var(--line);

    background: #fbfdfb;

    padding: 13px 15px;

    border-radius: 13px;

    transition: .2s ease;

    color: var(--text);

    font-weight: 650;

}


.option:hover:not(:disabled) {

    border-color: #9fc5ae;

    background: #f0f8f3;

    transform: translateX(3px);

}


.option.correct {

    border-color: #4aa56f;

    background: #e3f5e9;

}


.option.wrong {

    border-color: #d46b6b;

    background: #fae9e9;

}


.option:disabled {

    cursor: default;

}


.quiz-result {

    display: none;

    margin-top: 20px;

    padding: 18px;

    border-radius: 15px;

    background: var(--surface-2);

    font-weight: 750;

}


.checklist {

    display: grid;

    gap: 10px;

}


.check-item {

    display: flex;

    align-items: center;

    gap: 12px;

    border: 1px solid var(--line);

    border-radius: 14px;

    padding: 13px 14px;

    background: #fbfdfb;

    transition: .2s ease;

}


.check-item:hover {

    border-color: #b9d2c2;

}


.check-item input {

    appearance: none;

    width: 21px;

    height: 21px;

    border: 2px solid #aac4b4;

    border-radius: 7px;

    position: relative;

    flex: 0 0 auto;

    transition: .2s;

}


.check-item input:checked {

    background: var(--primary);

    border-color: var(--primary);

}


.check-item input:checked::after {

    content: "✓";

    position: absolute;

    color: white;

    font-size: 13px;

    font-weight: 900;

    left: 3px;

    top: -1px;

}


.check-item span {

    font-size: 13px;

    font-weight: 650;

}


.check-footer {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-top: 20px;

    color: var(--muted);

    font-size: 12px;

    font-weight: 800;

}


#check-progress {

    color: var(--primary);

}


/* =========================================================

   MITOS / VERDADES

========================================================= */

.fact-grid {

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 15px;

}


.fact {

    border: 1px solid var(--line);

    background: white;

    border-radius: 20px;

    overflow: hidden;

}


.fact-button {

    width: 100%;

    border: 0;

    background: transparent;

    padding: 20px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    text-align: left;

    font-weight: 800;

}


.fact-button span:last-child {

    color: var(--primary);

    font-size: 20px;

    transition: .25s;

}


.fact.open .fact-button span:last-child {

    transform: rotate(45deg);

}


.fact-answer {

    max-height: 0;

    overflow: hidden;

    transition: max-height .3s ease;

}


.fact-answer-inner {

    padding: 0 20px 20px;

    color: var(--muted);

    font-size: 13px;

}


.fact.open .fact-answer {

    /* Espaço suficiente para exibir a resposta completa em telas pequenas e grandes. */
    max-height: 500px;

}



/* =========================================================

   VÍDEO EDUCATIVO

========================================================= */

.video-card {

    background: var(--surface);

    border: 1px solid var(--line);

    border-radius: 30px;

    overflow: hidden;

    box-shadow: var(--shadow);

}


.video-wrapper {

    position: relative;

    width: 100%;

    aspect-ratio: 16 / 9;

    background: #0d1d15;

}


.video-wrapper iframe {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    border: 0;

}


.video-info {

    padding: 27px 30px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

}


.video-label {

    display: inline-block;

    color: var(--primary);

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 1.2px;

    text-transform: uppercase;

    margin-bottom: 7px;

}


.video-info h3 {

    font-size: 21px;

    line-height: 1.2;

    margin-bottom: 6px;

}


.video-info p {

    color: var(--muted);

    font-size: 13px;

    max-width: 720px;

}


/* =========================================================

   CONTROLE DE SOM DA NATUREZA

========================================================= */

.sound-control {

    position: fixed;

    left: 22px;

    bottom: 22px;

    z-index: 950;

    display: flex;

    align-items: center;

    gap: 9px;

    background: rgba(255,255,255,.94);

    border: 1px solid var(--line);

    box-shadow: var(--shadow-soft);

    border-radius: 999px;

    padding: 7px 9px 7px 12px;

    backdrop-filter: blur(12px);

}


.sound-status {

    font-size: 11px;

    color: var(--muted);

    font-weight: 800;

    white-space: nowrap;

}


.sound-btn {

    width: 38px;

    height: 38px;

    border: 0;

    border-radius: 50%;

    background: var(--primary);

    color: white;

    display: grid;

    place-items: center;

    transition: .2s ease;

}


.sound-btn:hover {

    transform: scale(1.05);

    background: var(--primary-dark);

}


@media (max-width: 720px) {

    .video-info {

        flex-direction: column;

        align-items: flex-start;

    }


    .sound-control {

        left: 12px;

        bottom: 12px;

    }


    .sound-status {

        display: none;

    }

}


/* =========================================================

   CTA

========================================================= */

.cta {

    margin-top: 30px;

    padding: 45px;

    border-radius: 30px;

    background: linear-gradient(135deg, #0e4d34, #238a5d);

    color: white;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 25px;

    overflow: hidden;

    position: relative;

}


.cta::after {

    content: "";

    position: absolute;

    width: 300px;

    height: 300px;

    border: 1px solid rgba(255,255,255,.13);

    border-radius: 50%;

    right: -80px;

    top: -140px;

    /* O elemento é apenas decorativo e não pode bloquear os cliques. */
    pointer-events: none;

}

/* Mantém o botão acima dos elementos decorativos do quadro. */
.cta .btn {
    position: relative;
    z-index: 1;
}


.cta h3 {

    font-size: 30px;

    line-height: 1.1;

    margin-bottom: 8px;

}


.cta p {

    opacity: .78;

    font-size: 14px;

    max-width: 600px;

}


.cta .btn {

    background: white;

    color: var(--primary-dark);

    flex: 0 0 auto;

}


/* =========================================================

   FOOTER

========================================================= */

footer {

    padding: 55px 0 30px;

    background: #10271c;

    color: white;

}


.footer-grid {

    display: grid;

    grid-template-columns: 1.4fr .6fr .6fr;

    gap: 45px;

    padding-bottom: 35px;

    border-bottom: 1px solid rgba(255,255,255,.10);

}


.footer-brand p {

    max-width: 420px;

    margin-top: 15px;

    color: rgba(255,255,255,.62);

    font-size: 13px;

}


.footer-title {

    font-size: 12px;

    text-transform: uppercase;

    letter-spacing: 1px;

    margin-bottom: 14px;

    color: rgba(255,255,255,.55);

}


.footer-links {

    display: grid;

    gap: 8px;

}


.footer-links a {

    color: rgba(255,255,255,.78);

    text-decoration: none;

    font-size: 13px;

}


.footer-links a:hover {

    color: white;

}


.copyright {

    padding-top: 24px;

    color: rgba(255,255,255,.45);

    font-size: 11px;

    display: flex;

    justify-content: space-between;

    gap: 20px;

}


/* =========================================================

   BOTÃO VOLTAR AO TOPO

========================================================= */

.to-top {

    position: fixed;

    right: 22px;

    bottom: 22px;

    z-index: 900;

    width: 45px;

    height: 45px;

    border: 0;

    border-radius: 14px;

    background: var(--primary);

    color: white;

    box-shadow: 0 12px 28px rgba(23,107,72,.22);

    opacity: 0;

    pointer-events: none;

    transform: translateY(12px);

    transition: .25s;

}


.to-top.show {

    opacity: 1;

    pointer-events: auto;

    transform: translateY(0);

}


/* =========================================================

   ANIMAÇÃO DE ENTRADA

========================================================= */

html.js .reveal {

    opacity: 0;

    transform: translateY(22px);

    transition: opacity .7s ease, transform .7s ease;

}


html.js .reveal.visible {

    opacity: 1;

    transform: translateY(0);

}

/* A seção Você sabia? permanece visível mesmo se as animações falharem. */
html.js #curiosidades .reveal {
    opacity: 1;
    transform: none;
}


