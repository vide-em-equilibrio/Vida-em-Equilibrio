<script>
(() => {
    const curiosidades = document.getElementById("curiosidades");
    if (!curiosidades) return;

    curiosidades.addEventListener("click", (event) => {
        const button = event.target.closest(".fact-button");
        if (!button || !curiosidades.contains(button)) return;

        const card = button.closest(".fact");
        if (!card) return;

        const shouldOpen = !card.classList.contains("open");
        curiosidades.querySelectorAll(".fact").forEach((item) => {
            item.classList.remove("open");
            const itemButton = item.querySelector(".fact-button");
            if (itemButton) {
                itemButton.setAttribute("aria-expanded", "false");
                const symbol = itemButton.querySelector("span:last-child");
                if (symbol) symbol.textContent = "+";
            }
        });

        if (shouldOpen) {
            card.classList.add("open");
            button.setAttribute("aria-expanded", "true");
            const symbol = button.querySelector("span:last-child");
            if (symbol) symbol.textContent = "−";
        }
    });
})();
</script>

