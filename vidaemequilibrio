/* =========================================================

   11. SOM AMBIENTE DE NATUREZA

   ---------------------------------------------------------

   O navegador normalmente bloqueia áudio automático.

   Por isso, o som começa quando o visitante clicar no botão.


   O áudio é criado pelo Web Audio API:

   - ruído suave = vento/folhagem

   - oscilações leves = ambiente natural

   - pequenos tons = efeito de pássaros

========================================================= */


const soundBtn =

    document.getElementById("soundBtn");


const soundStatus =

    document.getElementById("soundStatus");



let audioContext = null;

let natureMaster = null;

let noiseSource = null;

let windFilter = null;

let birdTimer = null;

let soundOn = false;



function criarSomNatureza() {


    audioContext =

        new (window.AudioContext || window.webkitAudioContext)();



    natureMaster =

        audioContext.createGain();


    natureMaster.gain.value = 0.0001;



    natureMaster.connect(

        audioContext.destination

    );



    /* -----------------------------------------------------

       Ruído contínuo para criar uma sensação suave de vento.

    ----------------------------------------------------- */


    const bufferSize =

        audioContext.sampleRate * 2;


    const buffer =

        audioContext.createBuffer(

            1,

            bufferSize,

            audioContext.sampleRate

        );



    const data =

        buffer.getChannelData(0);



    for (let i = 0; i < bufferSize; i++) {


        data[i] =

            (Math.random() * 2 - 1);


    }



    noiseSource =

        audioContext.createBufferSource();


    noiseSource.buffer = buffer;


    noiseSource.loop = true;



    windFilter =

        audioContext.createBiquadFilter();


    windFilter.type = "lowpass";


    windFilter.frequency.value = 850;



    const windGain =

        audioContext.createGain();


    windGain.gain.value = 0.035;



    noiseSource

        .connect(windFilter)

        .connect(windGain)

        .connect(natureMaster);



    noiseSource.start();



    /* -----------------------------------------------------

       Pequenas notas espaçadas para lembrar sons de pássaros.

    ----------------------------------------------------- */


    function passarinho() {


        if (!soundOn) {

            return;

        }



        const osc =

            audioContext.createOscillator();


        const gain =

            audioContext.createGain();



        const agora =

            audioContext.currentTime;



        const frequencia =

            1800 + Math.random() * 1100;



        osc.type = "sine";


        osc.frequency.setValueAtTime(

            frequencia,

            agora

        );


        osc.frequency.exponentialRampToValueAtTime(

            frequencia * 1.18,

            agora + 0.12

        );



        gain.gain.setValueAtTime(

            0.0001,

            agora

        );


        gain.gain.exponentialRampToValueAtTime(

            0.018,

            agora + 0.02

        );


        gain.gain.exponentialRampToValueAtTime(

            0.0001,

            agora + 0.18

        );



        osc.connect(gain);

        gain.connect(natureMaster);



        osc.start(agora);

        osc.stop(agora + 0.2);


    }



    function agendarPassarinho() {


        if (!soundOn) {

            return;

        }



        passarinho();



        birdTimer =

            setTimeout(

                agendarPassarinho,

                4500 + Math.random() * 7000

            );


    }



    agendarPassarinho();


}



async function ligarSomNatureza() {


    if (!audioContext) {


        criarSomNatureza();


    }



    if (audioContext.state === "suspended") {


        await audioContext.resume();


    }



    soundOn = true;



    natureMaster.gain.cancelScheduledValues(

        audioContext.currentTime

    );



    natureMaster.gain.setTargetAtTime(

        1,

        audioContext.currentTime,

        0.8

    );



    soundBtn.textContent = "🔊";


    soundStatus.textContent =

        "Som da natureza ligado";


}



function desligarSomNatureza() {


    if (!audioContext) {

        return;

    }



    soundOn = false;



    clearTimeout(birdTimer);



    natureMaster.gain.cancelScheduledValues(

        audioContext.currentTime

    );



    natureMaster.gain.setTargetAtTime(

        0.0001,

        audioContext.currentTime,

        0.5

    );



    soundBtn.textContent = "🔇";


    soundStatus.textContent =

        "Som da natureza desligado";


}



soundBtn.addEventListener("click", () => {


    if (soundOn) {


        desligarSomNatureza();


    } else {


        ligarSomNatureza();


    }


});


